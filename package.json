{
  "name": "mowram-weather-scraper",
  "version": "2.0.0",
  "description": "Professional weather data scraper for MOWRAM Cambodia",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "NODE_ENV=development nodemon src/server.js",
    "scrape": "node scripts/scrape.js",
    "scrape:windy": "node scripts/scrape-windy.js",
    "scrape:windy:aq": "node scripts/scrape-windy.js --air-quality",
    "scrape:windy:webcams": "node scripts/scrape-windy.js --webcams",
    "scrape:windy:all": "node scripts/scrape-windy.js --all",
    "lint": "eslint src/ scripts/",
    "lint:fix": "eslint src/ scripts/ --fix",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.js\" \"scripts/**/*.js\" \"*.json\" \"*.md\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "weather",
    "scraper",
    "cambodia",
    "mowram",
    "forecast",
    "windy",
    "air-quality",
    "webcams"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.78.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "node-fetch": "^3.3.2",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "nodemon": "^3.1.11",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
